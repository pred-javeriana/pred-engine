# Solo necesario para probe / ingest / run --provider. classify/verify/run canonico no necesita clave.
PRED_LLM_API_KEY=
# Opcional, por defecto ./data. --data-root tiene prioridad sobre esta variable.
PRED_DATA_ROOT=data
# Opcional, por defecto <PRED_DATA_ROOT>/pred.db. --db-path tiene prioridad sobre esta variable.
PRED_DB_PATH=
